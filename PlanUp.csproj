<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>PlanUp</AssemblyName>
    <RootNamespace>PlanUp</RootNamespace>
    <OutputType>Library</OutputType>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <OutputPath>C:\Users\wowyo\AppData\Roaming\Autodesk\Revit\Addins\2025\PlanUp\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharpCore" Version="1.3.65" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>C:\Program Files\Autodesk\Revit 2025\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\PlanUp_logo_white_transparent.png" />
    <None Include="Resources\PlanUp_logo_white_transparent.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Resources\PlanUp_logo_white_transparent.png</Link>
    </None>
    <Resource Include="Resources\icon_run_check.png" />
    <Resource Include="Resources\icon_settings.png" />
    <Resource Include="Resources\icon_report.png" />
    <Resource Include="Resources\icon_rules.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Rules\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Rules\%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
